<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0B0E14">

    <TextView
        android:text="SENSIX PRO"
        android:textColor="#00E676"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:text="Status: Connected"
        android:textColor="#8B949E"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnSmoothInject"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="1. INJECT SMOOTH HP"
        android:backgroundTint="#00E676"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnSmoothDrag"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="2. SMOOTH DRAG"
        android:backgroundTint="#29B6F6"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnRestore"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="RESTORE DEFAULT"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace"
        android:textColor="#8B949E" />

</LinearLayout>
