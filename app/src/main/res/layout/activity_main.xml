<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <FrameLayout
        android:id="@+id/frameContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView android:id="@+id/tabHome" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:text="Home" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="160dp" android:background="@drawable/bg_card_gradient" android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="GAME SENSIX" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:text="V2.0.0-PRO" android:textColor="#A0C0B0" android:textSize="12sp" android:layout_marginTop="4dp" />
                    <Button android:id="@+id/btnGoToInject" android:layout_width="120dp" android:layout_height="50dp" android:layout_gravity="end|bottom" android:layout_marginTop="20dp" android:text="Tuning" android:textColor="#000000" android:textStyle="bold" android:background="@drawable/bg_btn_gradient" />
                </LinearLayout>
                <TextView android:text="Perpustakaan Game" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/cardFreeFire" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:text="Free Fire" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
                    <TextView android:text=">" android:textColor="#FFFFFF" android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/tabProfile" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:text="Profile" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#00E676" android:padding="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/tvKeyDisplay" android:text="ianSENSIX-PRO" android:textColor="#003300" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvExpired" android:text="Berlaku Sampai: -" android:textColor="#004400" android:textSize="14sp" android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp">
                    <TextView android:id="@+id/tvSensiX" android:text="Sensi X : 100" android:textColor="#FFFFFF" />
                    <SeekBar android:id="@+id/seekSensiX" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#29B6F6" android:thumbTint="#29B6F6" />
                    <TextView android:id="@+id/tvSensiY" android:text="Sensi Y : 100" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
                    <SeekBar android:id="@+id/seekSensiY" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#00E676" android:thumbTint="#00E676" />
                    <Button android:id="@+id/btnApplySensi" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="12dp" android:text="Terapkan" android:backgroundTint="#333333" android:textColor="#FFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:text="CPU" android:textColor="#8B949E" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvCpu" android:text="0%" android:textColor="#00E676" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:text="PING" android:textColor="#8B949E" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvPing" android:text="0 ms" android:textColor="#00E676" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:text="GPU" android:textColor="#8B949E" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvGpu" android:text="0%" android:textColor="#00E676" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:text="RAM" android:textColor="#8B949E" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvRam" android:text="0 MB" android:textColor="#00E676" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:background="@drawable/bg_card_gradient" android:padding="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gabung Saluran Resmi" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:id="@+id/btnWa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WA" android:textColor="#00E676" android:textStyle="bold" android:padding="8dp"/>
                    <TextView android:id="@+id/btnTiktok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TT" android:textColor="#00E676" android:textStyle="bold" android:padding="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/tabSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:text="Tuning Engine" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="20dp" />
                <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status: Checking..." android:textColor="#8B949E" android:textSize="14sp" android:layout_marginBottom="20dp" />
                <Button android:id="@+id/btnSmoothInject" android:layout_width="match_parent" android:layout_height="60dp" android:text="1. INJECT SMOOTH HP" android:textStyle="bold" android:backgroundTint="#00E676" android:textColor="#000000"/>
                <Button android:id="@+id/btnSmoothDrag" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:text="2. SMOOTH DRAG" android:textStyle="bold" android:backgroundTint="#29B6F6" android:textColor="#000000"/>
                <Button android:id="@+id/btnRestore" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="Restore Default" android:backgroundTint="#333333" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="monospace" android:textColor="#8B949E" android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@drawable/bg_bottom_nav" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_indicator">
            <TextView android:text="⚡" android:textSize="20sp" android:textColor="#00E676" />
            <TextView android:text="Home" android:textSize="12sp" android:textColor="#00E676" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
            <TextView android:text="👤" android:textSize="20sp" android:textColor="#8B949E" />
            <TextView android:text="Profile" android:textSize="12sp" android:textColor="#8B949E" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
            <TextView android:text="⚙" android:textSize="20sp" android:textColor="#8B949E" />
            <TextView android:text="Tuning" android:textSize="12sp" android:textColor="#8B949E" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
